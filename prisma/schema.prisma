generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  firstName      String?
  lastName       String?
  fullName       String?
  role           String               @default("Staff")
  status         UserStatus           @default(ACTIVE)
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  trialEndsAt    DateTime?
  accounts       Account[]
  auditLogs      AuditLog[]
  payments       Payment[]
  sessions       Session[]
  subscription   Subscription?
  memberships    CompanyMembership[]
  ownedCompany   Company?             @relation("CompanyOwner")
  invitesSent    Invite[]             @relation("InviteInviter")
  membershipInvites CompanyMembership[] @relation("MembershipInviter")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String?
  companyId           String?
  tier                String
  status              String
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean   @default(false)
  canceledAt          DateTime?
  graceEnd            DateTime?
  paymentDeclinedDate DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  payments            Payment[]
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  company             Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([companyId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String?
  companyId         String?
  subscriptionId    String?
  amount            Float
  amountMinor       Int?
  currency          String
  status            String
  reference         String        @unique
  providerPaymentId String?
  createdAt         DateTime      @default(now())
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Company {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  contactEmail    String
  contactPhone    String?
  website         String?
  ownerPosition   String?
  status          CompanyStatus         @default(ACTIVE)
  addressLine1    String?
  addressLine2    String?
  addressLine3    String?
  addressLine4    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ownerId         String
  memberships     CompanyMembership[]
  invites         Invite[]
  auditLogs       AuditLog[]
  payments        Payment[]
  subscriptions   Subscription[]
  owner           User                  @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model CompanyMembership {
  id           String              @id @default(cuid())
  companyId    String
  userId       String
  role         String
  status       MembershipStatus    @default(PENDING)
  invitedById  String?
  invitedAt    DateTime?           @default(now())
  acceptedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?               @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([status])
}

model Invite {
  id            String         @id @default(cuid())
  companyId     String
  inviterId     String
  email         String
  role          String
  token         String         @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime       @default(now())
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter       User           @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventType   String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model EmailEvent {
  id           String   @id @default(cuid())
  messageId    String
  eventType    String
  email        String
  campaignId   String?
  customId     String?
  ip           String?
  geo          String?
  userAgent    String?
  url          String?
  isHardBounce Boolean?
  errorType    String?
  errorMessage String?
  spamSource   String?
  eventTime    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([messageId])
  @@index([eventType])
  @@index([eventTime])
}

model EmailStatus {
  id              String    @id @default(cuid())
  email           String    @unique
  isValid         Boolean   @default(true)
  bounceCount     Int       @default(0)
  lastBounceAt    DateTime?
  isBlacklisted   Boolean   @default(false)
  blacklistedAt   DateTime?
  blacklistReason String?
  isUnsubscribed  Boolean   @default(false)
  unsubscribedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isValid])
  @@index([isBlacklisted])
  @@index([isUnsubscribed])
}
