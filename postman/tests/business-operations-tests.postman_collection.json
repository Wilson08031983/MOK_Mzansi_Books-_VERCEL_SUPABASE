{
  "info": {
    "name": "MOK Mzansi Books - Business Operations Tests",
    "description": "Automated test collection for business operations including invoices, quotations, clients, and contacts",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "{{base_url}}",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Invoice Management",
      "description": "Test invoice creation and management functionality",
      "item": [
        {
          "name": "Create Invoice - Valid Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 200', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response contains invoice data', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('id');",
                  "    pm.expect(responseJson).to.have.property('invoiceNumber');",
                  "    pm.expect(responseJson).to.have.property('clientId');",
                  "});",
                  "",
                  "pm.test('Invoice number matches request', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const requestBody = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(responseJson.invoiceNumber).to.equal(requestBody.invoiceNumber);",
                  "});",
                  "",
                  "pm.test('Total amount is calculated correctly', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const requestBody = JSON.parse(pm.request.body.raw);",
                  "    ",
                  "    // Calculate expected total from items",
                  "    let expectedTotal = 0;",
                  "    requestBody.items.forEach(item => {",
                  "        expectedTotal += item.quantity * item.unitPrice;",
                  "    });",
                  "    ",
                  "    pm.expect(responseJson.total).to.equal(expectedTotal);",
                  "});",
                  "",
                  "// Store invoice ID for subsequent tests",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.environment.set('created_invoice_id', responseJson.id);",
                  "}",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique invoice number",
                  "const timestamp = Date.now();",
                  "const invoiceNumber = `INV-${timestamp}`;",
                  "pm.environment.set('unique_invoice_number', invoiceNumber);",
                  "",
                  "// Set dates",
                  "const today = new Date();",
                  "const dueDate = new Date(today.getTime() + (30 * 24 * 60 * 60 * 1000)); // 30 days from now",
                  "",
                  "pm.environment.set('invoice_issue_date', today.toISOString().split('T')[0]);",
                  "pm.environment.set('invoice_due_date', dueDate.toISOString().split('T')[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{test_client_id}}\",\n  \"invoiceNumber\": \"{{unique_invoice_number}}\",\n  \"issueDate\": \"{{invoice_issue_date}}\",\n  \"dueDate\": \"{{invoice_due_date}}\",\n  \"items\": [\n    {\n      \"description\": \"Web Development Services\",\n      \"quantity\": 40,\n      \"unitPrice\": 75.00\n    },\n    {\n      \"description\": \"Domain Registration\",\n      \"quantity\": 1,\n      \"unitPrice\": 15.00\n    }\n  ],\n  \"notes\": \"Payment due within 30 days\",\n  \"terms\": \"Net 30\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoices/create",
              "host": ["{{base_url}}"],
              "path": ["api", "invoices", "create"]
            }
          }
        },
        {
          "name": "Create Invoice - Missing Required Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.expect(pm.response.code).to.equal(400);",
                  "});",
                  "",
                  "pm.test('Response contains validation error', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('error');",
                  "    const errorMessage = responseJson.error.toLowerCase();",
                  "    pm.expect(errorMessage).to.satisfy(function(msg) {",
                  "        return msg.includes('required') || msg.includes('missing') || msg.includes('clientid');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNumber\": \"INV-INCOMPLETE\",\n  \"items\": [\n    {\n      \"description\": \"Test Service\",\n      \"quantity\": 1,\n      \"unitPrice\": 100.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoices/create",
              "host": ["{{base_url}}"],
              "path": ["api", "invoices", "create"]
            }
          }
        },
        {
          "name": "Create Invoice - Invalid Data Types",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () {",
                  "    pm.expect(pm.response.code).to.equal(400);",
                  "});",
                  "",
                  "pm.test('Response contains validation error', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('error');",
                  "    const errorMessage = responseJson.error.toLowerCase();",
                  "    pm.expect(errorMessage).to.satisfy(function(msg) {",
                  "        return msg.includes('invalid') || msg.includes('type') || msg.includes('number');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"invalid-client-id\",\n  \"invoiceNumber\": \"INV-INVALID\",\n  \"issueDate\": \"invalid-date\",\n  \"dueDate\": \"2024-01-01\",\n  \"items\": [\n    {\n      \"description\": \"Test Service\",\n      \"quantity\": \"not-a-number\",\n      \"unitPrice\": \"also-not-a-number\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/invoices/create",
              "host": ["{{base_url}}"],
              "path": ["api", "invoices", "create"]
            }
          }
        }
      ]
    },
    {
      "name": "Quotation Management",
      "description": "Test quotation creation and management functionality",
      "item": [
        {
          "name": "Create Quotation - Valid Data",
