  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script for business operations",
          "console.log('Running business operations test:', pm.info.requestName);",
          "pm.globals.set('test_start_time', Date.now());",
          "",
          "// Ensure we have required test data",
          "if (!pm.environment.get('test_client_id') && pm.info.requestName.includes('Invoice')) {",
          "    console.warn('Warning: test_client_id not set. Some invoice tests may fail.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script for business operations",
          "const testDuration = Date.now() - pm.globals.get('test_start_time');",
          "console.log('Test completed in:', testDuration + 'ms');",
          "",
          "// Check for proper JSON response",
          "pm.test('Response is valid JSON', function () {",
          "    pm.expect(() => pm.response.json()).to.not.throw();",
          "});",
          "",
          "// Check Content-Type header",
          "pm.test('Content-Type is application/json', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Log important response data for debugging",
          "if (pm.response.code >= 400) {",
          "    console.log('Error Response:', pm.response.text());",
          "} else if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    const responseJson = pm.response.json();",
          "    if (responseJson.id) {",
          "        console.log('Created resource ID:', responseJson.id);",
          "    }",
          "}"
        ]
      }
    }
  ]
}