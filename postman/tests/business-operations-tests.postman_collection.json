                  "pm.test('Quotation number matches request', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const requestBody = JSON.parse(pm.request.body.raw);",
                  "    pm.expect(responseJson.quotationNumber).to.equal(requestBody.quotationNumber);",
                  "});",
                  "",
                  "pm.test('Total amount is calculated correctly', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const requestBody = JSON.parse(pm.request.body.raw);",
                  "    ",
                  "    // Calculate expected total from items",
                  "    let expectedTotal = 0;",
                  "    requestBody.items.forEach(item => {",
                  "        expectedTotal += item.quantity * item.unitPrice;",
                  "    });",
                  "    ",
                  "    pm.expect(responseJson.total).to.equal(expectedTotal);",
                  "});",
                  "",
                  "// Store quotation ID for subsequent tests",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const responseJson = pm.response.json();",
                  "    pm.environment.set('created_quotation_id', responseJson.id);",
                  "}",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique quotation number",
                  "const timestamp = Date.now();",
                  "const quotationNumber = `QUO-${timestamp}`;",
                  "pm.environment.set('unique_quotation_number', quotationNumber);",
                  "",
                  "// Set dates",
                  "const today = new Date();",
                  "const validUntil = new Date(today.getTime() + (14 * 24 * 60 * 60 * 1000)); // 14 days from now",
                  "",
                  "pm.environment.set('quotation_issue_date', today.toISOString().split('T')[0]);",
                  "pm.environment.set('quotation_valid_until', validUntil.toISOString().split('T')[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{test_client_id}}\",\n  \"quotationNumber\": \"{{unique_quotation_number}}\",\n  \"issueDate\": \"{{quotation_issue_date}}\",\n  \"validUntil\": \"{{quotation_valid_until}}\",\n  \"items\": [\n    {\n      \"description\": \"Website Design & Development\",\n      \"quantity\": 1,\n      \"unitPrice\": 2500.00\n    },\n    {\n      \"description\": \"SEO Optimization\",\n      \"quantity\": 1,\n      \"unitPrice\": 500.00\n    },\n    {\n      \"description\": \"Monthly Maintenance\",\n      \"quantity\": 12,\n      \"unitPrice\": 150.00\n    }\n  ],\n  \"notes\": \"This quotation is valid for 14 days\",\n  \"terms\": \"50% deposit required, balance on completion\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/quotations/create",
              "host": ["{{base_url}}"],
              "path": ["api", "quotations", "create"]
            }
          }
        }
      ]
    },
