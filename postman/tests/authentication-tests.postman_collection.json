    {
      "name": "Rate Limiting Tests",
      "description": "Test rate limiting functionality",
      "item": [
        {
          "name": "Multiple Signup Attempts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// This test should be run multiple times to trigger rate limiting",
                  "pm.test('Response is handled appropriately', function () {",
                  "    // Accept both success and rate limit responses",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 429]);",
                  "});",
                  "",
                  "if (pm.response.code === 429) {",
                  "    pm.test('Rate limit response contains appropriate message', function () {",
                  "        const responseJson = pm.response.json();",
                  "        pm.expect(responseJson).to.have.property('error');",
                  "        const errorMessage = responseJson.error.toLowerCase();",
                  "        pm.expect(errorMessage).to.satisfy(function(msg) {",
                  "            return msg.includes('rate') || msg.includes('limit') || msg.includes('too many');",
                  "        });",
                  "    });",
                  "}",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique email for each attempt",
                  "const timestamp = Date.now();",
                  "const randomNum = Math.floor(Math.random() * 1000);",
                  "const testEmail = `rate-limit-test-${timestamp}-${randomNum}@mokmzansibooks.com`;",
                  "pm.environment.set('rate_limit_test_email', testEmail);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{rate_limit_test_email}}\",\n  \"password\": \"TestPassword123!\",\n  \"firstName\": \"Rate\",\n  \"lastName\": \"Limit\",\n  \"companyName\": \"Rate Limit Test Co\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "signup"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('Running authentication test:', pm.info.requestName);",
          "pm.globals.set('test_start_time', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "const testDuration = Date.now() - pm.globals.get('test_start_time');",
          "console.log('Test completed in:', testDuration + 'ms');",
          "",
          "// Common security headers check",
          "pm.test('Security headers are present', function () {",
          "    // Check for common security headers",
          "    const headers = pm.response.headers;",
          "    ",
          "    // These tests are optional as not all endpoints may have all headers",
          "    if (headers.has('X-Content-Type-Options')) {",
          "        pm.expect(headers.get('X-Content-Type-Options')).to.equal('nosniff');",
          "    }",
          "    ",
          "    if (headers.has('X-Frame-Options')) {",
          "        pm.expect(headers.get('X-Frame-Options')).to.be.oneOf(['DENY', 'SAMEORIGIN']);",
          "    }",
          "});",
          "",
          "// Log important response data for debugging",
          "if (pm.response.code >= 400) {",
          "    console.log('Error Response:', pm.response.text());",
          "}"
        ]
      }
    }
  ]
}