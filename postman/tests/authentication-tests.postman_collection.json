          }
        },
        {
          "name": "Sign Up - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 or 400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});",
                  "",
                  "pm.test('Response contains duplicate email error', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('error');",
                  "    const errorMessage = responseJson.error.toLowerCase();",
                  "    pm.expect(errorMessage).to.satisfy(function(msg) {",
                  "        return msg.includes('email') && (msg.includes('exists') || msg.includes('already') || msg.includes('duplicate'));",
                  "    });",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{unique_test_email}}\",\n  \"password\": \"TestPassword123!\",\n  \"firstName\": \"Duplicate\",\n  \"lastName\": \"User\",\n  \"companyName\": \"Duplicate Company\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "signup"]
            }
          }
        }
      ]
    },
    {
      "name": "Email Verification Flow",
      "description": "Email verification and resend functionality tests",
      "item": [
        {
          "name": "Verify Email - Valid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response indicates successful verification', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success');",
                  "    pm.expect(responseJson.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response contains verification message', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('message');",
                  "    pm.expect(responseJson.message.toLowerCase()).to.include('verified');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a mock verification token for testing",
                  "// In real scenarios, this would come from the signup response or email",
                  "const mockToken = 'mock-verification-token-' + Date.now();",
                  "pm.environment.set('mock_verification_token', mockToken);",
                  "",
                  "// Note: This test may fail in real scenarios without a valid token",
                  "// It's designed to test the endpoint structure and response format"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{mock_verification_token}}\",\n  \"userId\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "verify-email"]
            }
          }
        },
