              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RecordType\": \"Delivery\",\n  \"MessageID\": \"{{message_id}}\",\n  \"DeliveredAt\": \"{{delivered_at}}\",\n  \"Details\": \"{{delivery_details}}\",\n  \"Tag\": \"{{message_tag}}\",\n  \"Recipient\": \"{{recipient_email}}\"\n}"
            },
