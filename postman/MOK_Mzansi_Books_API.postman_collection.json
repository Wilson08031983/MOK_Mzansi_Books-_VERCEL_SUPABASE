              {
                "key": "X-Paystack-Signature",
                "value": "{{paystack_signature}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"id\": {{transaction_id}},\n    \"reference\": \"{{payment_reference}}\",\n    \"amount\": {{amount}},\n    \"currency\": \"ZAR\",\n    \"status\": \"success\",\n    \"customer\": {\n      \"email\": \"{{customer_email}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/paystack-webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "paystack-webhook"]
            },
            "description": "Handle Paystack payment webhooks"
          },
          "response": []
        },
