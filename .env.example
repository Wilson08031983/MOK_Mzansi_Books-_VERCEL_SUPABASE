# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
DIRECT_URL="postgresql://username:password@localhost:5432/database_name"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# PostMark Email Service
POSTMARK_API_TOKEN="your-postmark-server-api-token"
POSTMARK_FROM_EMAIL="MOK Mzansi Books <no-reply@mokmzansibooks.com>"
POSTMARK_REPLY_TO="support@mokmzansibooks.com"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Payment Processing
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
PAYSTACK_SECRET_KEY="your-paystack-secret-key"

# App Configuration
NEXT_PUBLIC_APP_URL="https://www.mokmzansibooks.com"
NEXT_PUBLIC_APP_NAME="MOK Mzansi Books"

# Analytics (Optional)
GOOGLE_ANALYTICS_ID="your-google-analytics-id"

# File Upload
MAX_FILE_SIZE="10485760" # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000" # 15 minutes in milliseconds

# Security
ENCRYPTION_KEY="your-32-character-encryption-key"
JWT_SECRET="your-jwt-secret-key"

# Development
NODE_ENV="development"
DEBUG="true"

# Email Template Configuration
EMAIL_TEMPLATE_BASE_URL="https://www.mokmzansibooks.com"
EMAIL_ASSETS_BASE_URL="https://mok-mzansi-books-vercel-sup-blob.vercel-storage.com"

# Company Information for Email Templates
COMPANY_NAME="MOK Mzansi Books"
COMPANY_EMAIL="info@mokmzansibooks.com"
COMPANY_PHONE="+27 (0) 11 123 4567"
COMPANY_ADDRESS="123 Literary Lane, Johannesburg, South Africa"
COMPANY_WEBSITE="https://www.mokmzansibooks.com"

# Social Media Links
SOCIAL_TWITTER="https://twitter.com/mokmzansibooks"
SOCIAL_FACEBOOK="https://facebook.com/mokmzansibooks"
SOCIAL_TIKTOK="https://tiktok.com/@mokmzansibooks"
SOCIAL_INSTAGRAM="https://instagram.com/mokmzansibooks"

# Banking Information for Invoices
BANK_NAME="First National Bank"
BANK_ACCOUNT_NAME="MOK Mzansi Books (Pty) Ltd"
BANK_ACCOUNT_NUMBER="1234567890"
BANK_BRANCH_CODE="250655"

# Invoice/Quotation Settings
DEFAULT_PAYMENT_TERMS="Net 30 days"
DEFAULT_DELIVERY_TIMEFRAME="5-7 business days"
QUOTATION_VALIDITY_PERIOD="30"
TAX_RATE="15" # VAT rate in South Africa

# Webhook URLs
POSTMARK_WEBHOOK_URL="https://www.mokmzansibooks.com/api/webhooks/postmark"
PAYSTACK_WEBHOOK_URL="https://www.mokmzansibooks.com/api/webhooks/paystack"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postmark
POSTMARK_SERVER_TOKEN="your-postmark-server-token"
POSTMARK_FROM_EMAIL="no-reply@yourdomain.com"
POSTMARK_MESSAGE_STREAM="outbound"

# Company config
COMPANY_NAME="MOK Mzansi Books"
COMPANY_EMAIL="support@yourdomain.com"
COMPANY_WEBSITE="https://yourdomain.com"
COMPANY_LOGO="/logo.svg"